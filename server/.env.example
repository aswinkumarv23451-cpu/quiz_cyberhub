# Server Configuration
PORT=5000
NODE_ENV=production
# CORS Allowed Origin(s): comma-separated or single URL (e.g., https://singular-horse-6400df.netlify.app)
CORS_ORIGIN=https://singular-horse-6400df.netlify.app

# Optional Cookie Configuration overrides
# In production, defaults to SameSite=None and Secure=true for cross-origin Netlify->Render support
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true
# COOKIE_DOMAIN=

# Production Safety Controls
# Set to 'true' during Club Member Mock Event practice run
# Set to 'false' during Final Real Competition for strict data protection
ALLOW_TEST_RESET=false

# Database Configuration (PostgreSQL)
# Option A: Single connection string (standard for Render / Neon / Supabase / Railway)
# DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/round1_db?sslmode=require
# Option B: Discrete parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=round1_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
# DB_SSL=true

# Module 3: Authentication & Security
# Comma-separated list of authorized admin emails
ADMIN_EMAILS=admin@round1.tech,organizer@round1.tech
# Strong random 32+ character secrets for JWT and OTP HMAC
JWT_SECRET=your_long_random_jwt_secret_here_min32chars
JWT_EXPIRES_IN=1h
OTP_HASH_SECRET=your_long_random_otp_hmac_secret_here_min32chars

# Official WhatsApp Group Link
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/REPLACE_WITH_ACTUAL_LINK

# Module 3: Transactional Email Service (SMTP)
# Options: 'smtp', 'test', 'unconfigured'
EMAIL_PROVIDER=unconfigured
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM_ADDRESS=noreply@round1.tech
EMAIL_FROM_NAME="Round 1 Technology Competition"
